{
  "manifest_version": 3,
  "name": "TOTP Authenticator",
  "version": "1.1.0",
  "description": "Local TOTP/2FA authenticator vault. Generate one-time codes, add accounts via QR or manual entry, import/export encrypted backups.",
  "permissions": ["storage", "activeTab", "alarms"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
